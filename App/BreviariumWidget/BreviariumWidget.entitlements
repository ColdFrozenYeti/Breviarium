<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The one entitlement (1.5, decided 2026-11-14): the App Group through which the widgets
  follow the app's settings (App/Shared/WidgetSettings.swift). Embedded only where the
  build is signed: App CI's simulator build and the TestFlight/App Store build. The
  sideloaded build (build-ipa.yml) is unsigned, so carries none, as CLAUDE.md requires.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.epavone.breviarium</string>
	</array>
</dict>
</plist>
