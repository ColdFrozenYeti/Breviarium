default_platform(:ios)

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

platform :ios do
  # One-time (or occasional) setup: creates/refreshes the App Store distribution
  # certificate and provisioning profile, storing them encrypted in the separate
  # match-storage repo (App/fastlane/Matchfile). Run manually via
  # .github/workflows/bootstrap-signing.yml — never needs a local Mac or an
  # interactive Apple ID login, since it authenticates with the App Store Connect
  # API key alone.
  desc "Create or refresh App Store signing certificates and profiles via match"
  lane :bootstrap_signing do
    connect_api_key
    match(type: "appstore", readonly: false)
  end

  # Builds and uploads a TestFlight build. Run via .github/workflows/testflight.yml,
  # manually or on a tag push. Requires bootstrap_signing to have run at least once.
  desc "Archive and upload the current build to TestFlight"
  lane :upload_testflight do
    api_key = connect_api_key
    match(type: "appstore", readonly: true)

    increment_build_number(
      xcodeproj: "Breviarium.xcodeproj",
      build_number: ENV.fetch("BUILD_NUMBER", latest_testflight_build_number(api_key: api_key) + 1).to_s
    )

    build_app(
      project: "Breviarium.xcodeproj",
      scheme: "Breviarium",
      export_method: "app-store",
      output_directory: "build"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
