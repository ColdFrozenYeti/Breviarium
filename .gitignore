# Swift Package Manager
.build/
.swiftpm/
Packages/BreviariumKit/.build/
Packages/BreviariumKit/.swiftpm/

# Xcode (project is generated by XcodeGen; nothing here should be committed)
App/*.xcodeproj/
App/*.xcworkspace/
DerivedData/
*.xcuserstate
*.xcuserdatad/

# build-ipa.yml's build output, if ever produced locally
App/build/
App/Payload/
App/*.ipa

# macOS
.DS_Store

# Generated data bundle (produced by BreviariumData; not hand-edited)
data/generated/
App/Breviarium/breviarium-data.json

# Local secrets/config that should never be committed
*.p8
*.p12
*.mobileprovision
.env

# scripts/generate-oracle-fixtures.sh's uncommitted staging area -- only the compressed
# archives it packs from this (data/oracle-fixtures/*.tar.gz, main/*.tar.gz) are committed.
data/oracle-fixtures/raw/
